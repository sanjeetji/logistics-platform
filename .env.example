# Docker Compose Environment
COMPOSE_PROJECT_NAME=logistics-platform
COMPOSE_PROFILES=dev

# Database
DB_HOST=mysql-db
DB_PORT=3306
DB_NAME=logistics_db
DB_USER=logistics_user
DB_PASSWORD=logistics_pass

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispass

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin123

# PostgreSQL Configuration
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
POSTGRES_USER=logistics_user
POSTGRES_PASSWORD=logistics_pass
POSTGRES_DATABASE=logistics_postgres
POSTGRES_CORE_DB=logistics_core_pg
POSTGRES_B2B_DB=logistics_b2b_pg
POSTGRES_B2C_DB=logistics_b2c_pg

# pgAdmin Configuration
PGADMIN_EMAIL=admin@logistics.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# Service URLs
EUREKA_URL=http://service-discovery:8761/eureka/
CONFIG_SERVER_URL=http://config-server:8888

# NVD API Key (Get one from https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=
